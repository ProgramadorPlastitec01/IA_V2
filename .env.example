# Backend Server Configuration
PORT=3000
NODE_ENV=development

# CORS Configuration
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5180,http://localhost:3000

# NotebookLM Configuration
# Name of the RRHH notebook in NotebookLM
NOTEBOOK_NAME=RRHH

# Google Cloud Text-to-Speech Configuration
# 1. Create a project at: https://console.cloud.google.com/
# 2. Enable "Cloud Text-to-Speech API"
# 3. Create a service account with role "Cloud Text-to-Speech User"
# 4. Download JSON key file and save it in the project root
# 5. Set the path to the JSON file below
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json

# Optional: Logging
LOG_LEVEL=info

# Optional: Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Qdrant Configuration
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=rrhh_docs

# Embeddings Configuration
# provider puede ser 'openai' o 'local'
EMBEDDINGS_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

